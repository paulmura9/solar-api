  "description": "LightTrack Solar Tracker — Express TypeScript backend API and MQTT ingestion worker",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "build": "tsc",
